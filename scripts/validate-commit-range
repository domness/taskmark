#!/bin/sh

set -eu

base="${1:-}"
head="${2:-HEAD}"

if [ -z "$base" ]; then
    printf '%s\n' "usage: scripts/validate-commit-range <base> [head]" >&2
    exit 2
fi

message_file="$(mktemp)"
trap 'rm -f "$message_file"' EXIT

# Merge subjects are generated by Git; still validate every ordinary commit brought in by the merge.
for commit in $(git rev-list --no-merges "$base..$head"); do
    git show -s --format=%B "$commit" > "$message_file"
    scripts/validate-commit-message "$message_file"
done
